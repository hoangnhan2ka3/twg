{
    "name": "twg",
    "version": "8.0.0-beta.0",
    "description": "A utility function for grouping Tailwind CSS variants.",
    "keywords": [
        "classnames",
        "clsx",
        "grouping tailwind variants",
        "grouping variants",
        "tailwind",
        "tailwind variants grouping",
        "tailwindcss",
        "tvg",
        "twg",
        "variants grouping"
    ],
    "homepage": "https://github.com/aimryoui/twg",
    "bugs": {
        "url": "https://github.com/aimryoui/twg/issues"
    },
    "license": "MIT",
    "author": "Nguyễn Hoàng Nhân <workwith.hnhan@gmail.com> (https://github.com/aimryoui)",
    "repository": {
        "type": "git",
        "url": "https://github.com/aimryoui/twg"
    },
    "funding": {
        "type": "github",
        "url": "https://github.com/sponsors/aimryoui"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./transform": {
            "import": {
                "types": "./dist/transformer.d.mts",
                "default": "./dist/transformer.mjs"
            },
            "require": {
                "types": "./dist/transformer.d.cts",
                "default": "./dist/transformer.cjs"
            }
        }
    },
    "scripts": {
        "build": "tsdown --config-loader unrun",
        "test": "vitest run",
        "npm": "pnpm build && pnpm publish --access public",
        "npm:beta": "pnpm build && pnpm publish --access public --tag beta",
        "npm:remove-beta": "pnpm dist-tag rm twg beta",
        "format": "oxfmt --threads 8 && biome check --write",
        "format:check": "oxfmt --check --threads 8 && biome check",
        "lint": "oxlint --threads 8",
        "lint:fix": "oxlint --fix --threads 8",
        "check": "tsc --noEmit"
    },
    "dependencies": {
        "acorn": "^8.18.0",
        "oxc-parser": "^0.147.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.10",
        "@limegrass/eslint-plugin-import-alias": "^1.6.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/eslint": "^9.6.1",
        "@types/estree": "^1.0.9",
        "@types/node": "^26.4.0",
        "@typescript-eslint/eslint-plugin": "^8.68.0",
        "@typescript-eslint/parser": "^8.68.0",
        "eslint": "^9.39.5",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "jiti": "^2.7.0",
        "oxfmt": "^0.65.0",
        "oxlint": "^1.80.0",
        "oxlint-tsgolint": "^7.0.2001",
        "terser": "^5.51.1",
        "tsdown": "^0.22.14",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2",
        "unrun": "^0.3.1",
        "vitest": "^4.1.11"
    },
    "overrides": {
        "rollup-plugin-dts": "^6.5.1"
    },
    "engines": {
        "node": "^24.15.0"
    },
    "packageManager": "pnpm@11.24.0",
    "cjs": "dist/index.cjs"
}
